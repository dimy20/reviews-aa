# Copy to deploy/caddy.env on the server and `chmod 600` it. Never commit the real file.
LABELS_DOMAIN=labels.example.com
BASIC_AUTH_USER=equipo
# Generate with:  docker run --rm caddy:2.10 caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains "$", which Docker Compose would otherwise
# try to expand as variables.
BASIC_AUTH_HASH='$2a$14$...'
